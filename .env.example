# Copy this to .env and fill in what you want to use.
# Leave a section blank to disable that alert channel.
# Console output always works regardless.

# --- Email (SMTP) ---
# Gmail example: use an App Password (Google Account > Security > App Passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=

# --- ntfy.sh push (simplest phone push, no account needed) ---
# 1. Install the "ntfy" app (iOS/Android)
# 2. Pick a long, unguessable topic name — it acts as your password
# 3. Subscribe to that topic in the app, put the same name here
NTFY_TOPIC=

# --- Telegram ---
# 1. Message @BotFather on Telegram, /newbot, copy the token
# 2. Message your new bot once, then get your chat id from
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
